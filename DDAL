#include <GL/glut.h>
#include <cstdlib>
#include <iostream>
using namespace std;

float x1, y1, x2, y2; // Corrected variable names

void init(void) {
    glClearColor(1.0, 0.0, 0.0, 0.0); // Background color: red
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluOrtho2D(-100, 100, -100, 100); // 2D coordinate system
}

void drawLineDDA() {
    float dx, dy, x, y, xInc, yInc;
    int steps;

    dx = x2 - x1;
    dy = y2 - y1;

    steps = (abs(dx) > abs(dy)) ? abs(dx) : abs(dy);

    xInc = dx / steps;
    yInc = dy / steps;

    x = x1;
    y = y1;

    glBegin(GL_POINTS);
    for (int k = 0; k <= steps; k++) {
        glVertex2i((int)(x + 0.5), (int)(y + 0.5)); // rounding to nearest int
        x += xInc;
        y += yInc;
    }
    glEnd();
    glFlush();
}

void display() {
    glClear(GL_COLOR_BUFFER_BIT);

    cout << "\nSimple Line (DDA Algorithm)\n";
    cout << "Enter value of x1: ";
    cin >> x1;
    cout << "Enter value of y1: ";
    cin >> y1;
    cout << "Enter value of x2: ";
    cin >> x2;
    cout << "Enter value of y2: ";
    cin >> y2;

    drawLineDDA();
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(500, 500);
    glutInitWindowPosition(100, 100);
    glutCreateWindow("DDA Line Drawing Algorithm");
    init();
    glutDisplayFunc(display);
    glutMainLoop();
    return 0;
}

